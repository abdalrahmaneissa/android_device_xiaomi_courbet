soong_namespace {
    imports: [
        "vendor/qcom/opensource/usb/etc",
    ],
}

install_symlink {
    name: "sku_courbet_audio_symlink",
    installed_location: "etc/audio/sku_courbet",
    symlink_target: "/vendor/etc",
    vendor: true,
}